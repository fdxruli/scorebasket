+  // QA-27: Adversarial - Continuidad del Generador de Claves Auto-incrementales tras Restaurar
+  it('QA-27: Continuidad de claves: tras restaurar registros con IDs expl├¡citos, db.table.add() genera el siguiente ID sin colisi├│n', async () => {
+    // Respaldo con equipos en IDs no contiguos: 10 y 5000
+    const rawBackup = {
