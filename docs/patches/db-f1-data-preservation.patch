+  const playerMap = new Map(players.map(p => [p.id!, p]));
+  const matchMap = new Map(matches.map(m => [m.id!, m]));
+
+  // 3. Validaci├│n relacional de jugadores -> equipos
+  for (const player of players) {
+    const teamId = parseValidId(player.teamId, `player[#${player.id}].teamId`);
+    if (!teamIds.has(teamId)) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: el jugador "${player.name}" (#${player.id}) referencia al equipo inexistente #${teamId}.`
+      );
+    }
+  }
+
+  // 4. Validaci├│n de partidos
+  const validStatuses = new Set(['created', 'playing', 'paused', 'finished']);
+  for (const match of matches) {
+    const localId = parseValidId(match.localTeamId, `match[#${match.id}].localTeamId`);
+    const visitorId = parseValidId(match.visitorTeamId, `match[#${match.id}].visitorTeamId`);
+
+    if (!teamIds.has(localId)) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: el partido #${match.id} referencia a un equipo local inexistente (#${localId}).`
+      );
+    }
+    if (!teamIds.has(visitorId)) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: el partido #${match.id} referencia a un equipo visitante inexistente (#${visitorId}).`
+      );
+    }
+    if (localId === visitorId) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: el partido #${match.id} tiene al mismo equipo como local y visitante (#${localId}).`
+      );
+    }
+
+    if (!validStatuses.has(match.status)) {
+      throw new BackupValidationError(
+        `Estado deportivo inv├ílido en el partido #${match.id}: "${match.status}".`
+      );
+    }
