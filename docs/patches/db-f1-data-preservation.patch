+    // Insertar un nuevo equipo mediante db.teams.add() sin ID expl├¡cito
+    const nextId = (await db.teams.add({
+      name: 'Team Cinco Mil Uno',
+      createdAt: new Date(),
+      isArchived: false
+    })) as number;
+
+    // Seg├║n la especificaci├│n W3C de IndexedDB (3.1.5 Key Generators),
