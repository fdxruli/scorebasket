+
+function countRecords(data: BackupData): BackupCounts {
+  return {
+    teams: data.teams.length,
+    players: data.players.length,
+    matches: data.matches.length,
+    scores: data.scores.length,
+    fouls: data.fouls.length
+  };
+}
