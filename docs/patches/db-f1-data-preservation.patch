+    if (score.teamId !== match.localTeamId && score.teamId !== match.visitorTeamId) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: la anotaci├│n #${score.id} pertenece al equipo #${score.teamId}, que no participa en el partido #${matchId}.`
