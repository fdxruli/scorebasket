+    if (!Number.isSafeInteger(foul.quarter) || foul.quarter < 1) {
+      throw new BackupValidationError(`Periodo inv├ílido en la falta #${foul.id}: debe ser un entero >= 1.`);
+    }
+
+    if (foul.playerId !== undefined && foul.playerId !== null) {
+      const playerId = parseValidId(foul.playerId, `foul[#${foul.id}].playerId`);
+      if (!playerIds.has(playerId)) {
+        throw new BackupValidationError(
+          `Relaci├│n inv├ílida: la falta #${foul.id} referencia al jugador inexistente #${playerId}.`
+        );
+      }
+      const player = playerMap.get(playerId)!;
+      if (player.teamId !== foul.teamId) {
+        throw new BackupValidationError(
+          `Relaci├│n inv├ílida: la falta #${foul.id} se registra para el jugador #${playerId} del equipo #${player.teamId}, pero la falta corresponde al equipo #${foul.teamId}.`
