+      const playerId = parseValidId(score.playerId, `score[#${score.id}].playerId`);
+      if (!playerIds.has(playerId)) {
+        throw new BackupValidationError(
+          `Relaci├│n inv├ílida: la anotaci├│n #${score.id} referencia al jugador inexistente #${playerId}.`
+        );
+      }
+      const player = playerMap.get(playerId)!;
+      if (player.teamId !== score.teamId) {
+        throw new BackupValidationError(
+          `Relaci├│n inv├ílida: la anotaci├│n #${score.id} asigna puntos al jugador #${playerId} que pertenece al equipo #${player.teamId}, pero la anotaci├│n es para el equipo #${score.teamId}.`
+        );
+      }
+    }
+  }
+
+  for (const foul of fouls) {
+    const matchId = parseValidId(foul.matchId, `foul[#${foul.id}].matchId`);
+    if (!matchIds.has(matchId)) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: la falta #${foul.id} referencia a un partido inexistente (#${matchId}).`
+      );
+    }
+    const match = matchMap.get(matchId)!;
+
+    if (foul.teamId !== match.localTeamId && foul.teamId !== match.visitorTeamId) {
+      throw new BackupValidationError(
+        `Relaci├│n inv├ílida: la falta #${foul.id} pertenece al equipo #${foul.teamId}, que no participa en el partido #${matchId}.`
+      );
+    }
